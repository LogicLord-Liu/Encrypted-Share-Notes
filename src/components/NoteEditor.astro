---
// src/components/NoteEditor.astro
---

<main class="flex-grow flex flex-col lg:flex-row p-6 gap-6">
  <div class="flex-grow flex flex-col gap-6">
    <div
      class="flex-grow relative glass-effect rounded-3xl shadow-lg border border-white/20"
    >
      <textarea
        id="note-content"
        placeholder="在此输入您的笔记 (支持 Markdown)..."
        class="w-full h-full p-6 text-lg font-mono
               bg-transparent placeholder-gray-400/70
               text-gray-800 dark:text-gray-100
               rounded-3xl font-bold
               shadow-sm focus:shadow-xl focus:border-blue-400/40
               outline-none resize-none transition-all duration-300
               scrollbar-thin scrollbar-thumb-gray-300 dark:scrollbar-thumb-gray-600 scrollbar-track-transparent
               sm:text-base md:text-lg lg:text-xl"
      ></textarea>
      <div
        id="character-count"
        class="absolute bottom-4 right-4 text-sm text-gray-500 dark:text-gray-400 font-medium"
      >
        0 字符
      </div>
    </div>

    <div
      class="flex-grow glass-effect rounded-3xl shadow-lg border border-white/20 p-6 overflow-y-auto"
    >
      <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-4">
        预览
      </h3>
      <div
        id="note-preview"
        class="prose prose-indigo dark:prose-invert max-w-none leading-relaxed preview-content"
      >
      </div>
    </div>
  </div>

  <!-- 右侧：设置面板 -->
  <aside
    class="w-full lg:w-96 glass-effect rounded-3xl shadow-lg border border-white/20 p-6 flex flex-col gap-5"
  >
    <!-- 密码设置 -->
    <div>
      <label
        for="note-password"
        class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2"
        >笔记密码</label
      >
      <div class="relative flex items-center">
        <input
          type="password"
          id="note-password"
          placeholder="密码..."
          class="flex-grow glass-input border border-gray-200 dark:border-gray-700 rounded-xl py-2.5 px-4 text-gray-800 dark:text-gray-200 font-bold focus:outline-none focus:ring-2 focus:ring-blue-400/50 transition-all"
        />
        <button
          id="toggle-password"
          class="absolute right-10 p-1.5 text-gray-500 hover:text-blue-500 transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            id="eye-open"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
            ></path>
          </svg>

          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            id="eye-closed"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.875 18.825A10.05 10.05 0 0112 19c-4.477 0-8.268-2.943-9.542-7a9.956 9.956 0 012.233-3.291m2.158-1.965a3 3 0 114.243 4.243"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18"
            ></path>
          </svg>
        </button>
        <button
          id="generate-password"
          class="absolute right-2 p-1.5 text-gray-500 hover:text-blue-500 transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 4v5h.582M20 20v-5h-.581M5.82 9a7 7 0 0112.36-2.02M18.18 15a7 7 0 01-12.36 2.02"
            ></path>
          </svg>
        </button>
      </div>

      <div class="mt-4">
        <div class="flex justify-between items-end mb-2 px-1">
          <span class="text-[9px] font-bold uppercase tracking-[0.25em] text-gray-400/80 dark:text-gray-500">
            Security Level
          </span>
          <span 
            id="password-strength-text" 
            class="text-[11px] font-black uppercase tracking-tighter transition-all duration-300 text-gray-400"
          >
            WAITING
          </span>
        </div>

        <div class="flex gap-1.5 h-1 px-0.5">
          <div class="pw-strip h-full flex-1 rounded-full bg-gray-200/50 dark:bg-gray-800/50 transition-all duration-500"></div>
          <div class="pw-strip h-full flex-1 rounded-full bg-gray-200/50 dark:bg-gray-800/50 transition-all duration-500"></div>
          <div class="pw-strip h-full flex-1 rounded-full bg-gray-200/50 dark:bg-gray-800/50 transition-all duration-500"></div>
          <div class="pw-strip h-full flex-1 rounded-full bg-gray-200/50 dark:bg-gray-800/50 transition-all duration-500"></div>
        </div>

        <div class="mt-2 min-h-[14px] px-1">
          <p 
            id="pw-helper-text" 
            class="text-[10px] font-medium leading-relaxed text-gray-400/80 dark:text-gray-500 opacity-0 transition-all duration-300 transform translate-y-1"
          >
          </p>
        </div>
      </div>
    </div>

    <!-- 过期时间 -->
    <div>
      <label
        class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2"
        >过期延迟</label
      >
      <div
        id="expiration-options"
        class="grid grid-cols-2 sm:grid-cols-4 gap-2"
      >
        <button
          data-value="1hour"
          class="py-2.5 px-4 rounded-xl text-sm font-medium transition-all bg-blue-500/90 text-white shadow-sm"
          >1 H</button
        >
        <button
          data-value="1day"
          class="py-2.5 px-4 rounded-xl text-sm font-medium transition-all bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-500/10 hover:text-blue-600"
          >1 D</button
        >
        <button
          data-value="1week"
          class="py-2.5 px-4 rounded-xl text-sm font-medium transition-all bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-500/10 hover:text-blue-600"
          >1 W</button
        >
        <button
          data-value="1month"
          class="py-2.5 px-4 rounded-xl text-sm font-medium transition-all bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-500/10 hover:text-blue-600"
          >1 M</button
        >
      </div>
    </div>

    <!-- 永不过期 -->
    <div class="flex items-center justify-between">
      <span class="text-sm font-semibold text-gray-700 dark:text-gray-300"
        >永不过期</span
      >
      <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" id="never-expires" class="sr-only peer" />
        <div
          class="w-12 h-6 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300/50 rounded-full peer peer-checked:after:translate-x-[18px] peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border after:border-gray-300 after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-500"
        >
        </div>
      </label>
    </div>

    <!-- 阅后即焚 -->
    <div class="flex items-center justify-between">
      <span class="text-sm font-semibold text-gray-700 dark:text-gray-300"
        >阅后即焚</span
      >
      <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" id="delete-after-reading" class="sr-only peer" />
        <div
          class="w-12 h-6 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300/50 rounded-full peer peer-checked:after:translate-x-[18px] peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border after:border-gray-300 after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-500"
        >
        </div>
      </label>
    </div>

    <div class="flex items-center justify-between">
      <span class="text-sm font-semibold text-gray-700 dark:text-gray-300"
        >访问次数限制</span
      >
      <div class="flex items-center gap-2">
        <input 
          type="number" 
          id="max-access" 
          placeholder="0" 
          min="0"
          class="w-16 glass-input border border-gray-200 dark:border-gray-700 rounded-lg py-1 px-2 text-center text-sm font-bold text-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-400"
        />
        <span class="text-[10px] text-gray-400 font-bold uppercase">Times</span>
      </div>
    </div>

    <div class="flex items-center justify-between">
      <div class="flex flex-col">
        <span class="text-sm font-semibold text-gray-700 dark:text-gray-300">防爆破模式</span>
        <span class="text-[9px] text-gray-400 uppercase tracking-tighter">High-Cost Decryption</span>
      </div>
      <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" id="anti-brute-force" class="sr-only peer" />
        <div
          class="w-12 h-6 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-indigo-300/50 rounded-full peer peer-checked:after:translate-x-[18px] peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border after:border-gray-300 after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-500"
        >
        </div>
      </label>
    </div>

    <!-- 附件上传 -->
    <div>
      <button
        id="upload-btn"
        class="w-full py-3 px-5 rounded-xl bg-gradient-to-r from-blue-500 to-indigo-500 text-white font-semibold text-base shadow-md hover:shadow-xl hover:from-blue-600 hover:to-indigo-600 flex items-center justify-center gap-2 transition-all duration-300 active:scale-95"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1M16 10l-4-4m0 0L8 10m4-4v12"
          ></path>
        </svg>
        <span>附加文件</span>
      </button>

      <input type="file" id="file-input" class="hidden" multiple />

      <div
        id="upload-area"
        class="mt-4 hidden border-2 border-dashed border-gray-200 dark:border-gray-700 p-4 rounded-xl text-gray-600 dark:text-gray-400"
      >
        <p class="mb-3 font-medium flex items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            ></path>
          </svg>
          已选择文件：
        </p>
        <div
          id="file-list"
          class="space-y-2 max-h-40 overflow-y-auto pr-1 scrollbar-thin scrollbar-thumb-gray-300 dark:scrollbar-thumb-gray-600"
        >
        </div>
        <div
          id="error-message"
          class="mt-3 hidden text-red-500 text-sm flex items-center gap-2"
        >
          <svg
            class="w-4 h-4 text-red-500 flex-shrink-0"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm2.12-10.12a1 1 0 00-1.41 0L10 8.59 9.29 7.88a1 1 0 10-1.41 1.41L8.59 10l-.71.71a1 1 0 101.41 1.41L10 11.41l.71.71a1 1 0 001.41-1.41L11.41 10l.71-.71a1 1 0 000-1.41z"
              clip-rule="evenodd"></path>
          </svg>
          <span id="error-text"></span>
        </div>
      </div>
    </div>

    <div class="mt-auto pt-4">
      <button
        id="create-note-button"
        class="w-full py-3.5 bg-gradient-to-r from-blue-500 to-indigo-500 text-white rounded-2xl text-lg font-semibold hover:from-blue-600 hover:to-indigo-600 shadow-md hover:shadow-xl transition-all active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        创建笔记
      </button>
    </div>
  </aside>
</main>

<!-- Success Modal & Error Popup Code Remains Unchanged... -->
<div
  id="success-modal"
  class="fixed inset-0 bg-black/50 glass-overlay flex items-center justify-center p-4 z-50 hidden transition-opacity duration-300"
>
  <div
    id="success-modal-content"
    class="glass-card rounded-3xl shadow-2xl border border-white/20 p-8 w-full max-w-md transform transition-transform duration-300 scale-95 opacity-0"
  >
    <div class="flex flex-col items-center mb-4">
      <div class="success-checkmark mb-3">
        <div class="check-icon">
          <span class="icon-line line-tip"></span>
          <span class="icon-line line-long"></span>
          <div class="icon-circle"></div>
        </div>
      </div>
      
      <h2 class="text-xl font-black text-center bg-clip-text text-transparent bg-gradient-to-r from-emerald-600 to-teal-500 dark:from-emerald-400 dark:to-cyan-400 tracking-tight">
        创建成功
      </h2>
      <p class="text-center text-xs text-gray-500 dark:text-gray-400 mt-1 max-w-[200px]">
        您的加密笔记已存至云端。
      </p>
    </div>

    <div class="mb-6">
      <label
        class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
      >
        🔗 加密链接
      </label>
      <div class="relative">
        <input
          type="text"
          id="encrypted-link-display"
          readonly
          class="w-full p-3 pr-12 glass-input border border-gray-200 dark:border-gray-700 text-gray-800 dark:text-white rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-400/50"
        />
        <div
          class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-2"
        >
          <button
            id="share-email-button"
            title="通过邮件分享"
            class="p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-500 transition"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </button>

          <button
            id="copy-link-button"
            title="复制链接"
            class="p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-500 transition"
          >
            <svg
              id="copy-icon"
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3"
              ></path>
            </svg>
            <svg
              id="check-icon"
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 text-green-500 hidden"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
          </button>
        </div>
      </div>
      <p
        id="copy-feedback"
        class="text-xs text-green-500 mt-1 text-right transition-opacity duration-300 ease-in-out opacity-0"
      >
        已复制！
      </p>
    </div>

    <div class="mb-6">
      <label
        class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2 flex items-center gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
        </svg>
        分享二维码
      </label>
      <div class="relative group">
        <div class="absolute -inset-2 bg-gradient-to-r from-blue-500/10 to-indigo-500/10 rounded-[2rem] blur-xl opacity-0 group-hover:opacity-100 transition duration-1000"></div>
        <div class="relative flex flex-col items-center p-5 rounded-2xl border border-gray-100 dark:border-gray-700/50 bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm shadow-sm">
          <div class="relative p-2 bg-white rounded-xl shadow-inner-lg">
            <canvas id="qrcode-canvas" class="w-32 h-32"></canvas>
            <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-blue-500 rounded-tl"></div>
            <div class="absolute top-0 right-0 w-3 h-3 border-t-2 border-r-2 border-blue-500 rounded-tr"></div>
            <div class="absolute bottom-0 left-0 w-3 h-3 border-b-2 border-l-2 border-blue-500 rounded-bl"></div>
            <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-blue-500 rounded-br"></div>
          </div>
          <div class="mt-4 flex flex-col items-center">
            <span class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-[0.2em]">移动端安全扫码</span>
          </div>
        </div>
      </div>
    </div>

    <div class="flex justify-end">
      <button
        id="close-modal-button"
        class="px-6 py-2.5 bg-gradient-to-r from-blue-500 to-indigo-500 hover:from-blue-600 hover:to-indigo-600 text-white rounded-xl text-sm font-semibold shadow-sm hover:shadow-md transition-all"
      >
        关闭
      </button>
    </div>
  </div>
</div>

<div
  id="error-popup"
  class="fixed inset-0 z-50 flex items-center justify-center hidden"
>
  <div
    class="absolute inset-0 bg-gray-900/70 glass-overlay opacity-75 transition-opacity duration-300"
    id="error-popup-overlay"
  >
  </div>

  <div
    id="error-popup-content"
    class="relative glass-card rounded-3xl shadow-2xl border border-white/20 p-6 sm:p-8 max-w-sm w-full mx-4 transform scale-90 opacity-0 transition-all duration-300 ease-out"
  >
    <div class="flex flex-col items-center">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-16 w-16 text-red-500 mb-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>

      <h3
        class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-400 mb-2"
      >
        操作冲突
      </h3>
      <p
        class="text-sm text-center text-gray-600 dark:text-gray-300"
        id="error-popup-message"
      >
        请先取消一个选项。
      </p>
    </div>

    <div class="mt-6">
      <button
        id="error-popup-close-btn"
        class="w-full px-4 py-3 text-white text-base font-semibold bg-gradient-to-r from-red-500 to-orange-500 rounded-xl hover:from-red-600 hover:to-orange-600 shadow-sm hover:shadow-md transition-all"
      >
        我明白了
      </button>
    </div>
  </div>
</div>

<script is:inline>
  if (typeof window !== "undefined") {
    const script = document.createElement("script");
    script.src =
      "https://cdn.jsdelivr.net/npm/markdown-it@13.0.1/dist/markdown-it.min.js";
    script.onload = () => {
      const md = new markdownit({
        breaks: true,
        html: true,
        linkify: true,
      });

      const defaultRender =
        md.renderer.rules.text ||
        function (tokens, idx, options, env, self) {
          return self.renderToken(tokens, idx, options);
        };

      md.renderer.rules.text = function (tokens, idx, options, env, self) {
        let text = tokens[idx].content;
        text = text.replace(/ /g, "&nbsp;");
        text = text.replace(/　/g, "&nbsp;");
        return defaultRender(tokens, idx, options, env, self).replace(
          text,
          text,
        );
      };

      const noteContentInput = document.getElementById("note-content");
      const characterCountElement = document.getElementById("character-count");
      const notePreviewElement = document.getElementById("note-preview");

      if (noteContentInput && characterCountElement && notePreviewElement) {
        const updateContent = () => {
          const count = noteContentInput.value.length;
          characterCountElement.textContent = `${count} 字符`;

          const markdownText = noteContentInput.value;
          const htmlContent = md.render(markdownText);
          notePreviewElement.innerHTML = htmlContent;
        };

        updateContent();

        noteContentInput.addEventListener("input", updateContent);
      }
    };
    document.head.appendChild(script);
  }
</script>

