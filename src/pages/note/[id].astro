---
// src/pages/note/[id].astro
import Layout from "../../layouts/Layout.astro";
const { id } = Astro.params;
---

<Layout title="查看笔记 - Transcrypt">
  <main class="flex flex-col items-center justify-center min-h-screen p-4">
    <div
      class="bg-white p-6 sm:p-10 rounded-2xl shadow-2xl w-full max-w-3xl text-center"
    >
      <h1 class="text-3xl font-bold mb-8 text-gray-800 tracking-tight">
        笔记内容
      </h1>

      <div id="status-area">
        <div class="flex flex-col items-center">
          <div
            class="animate-spin rounded-full h-10 w-10 border-b-2 border-sky-500 mb-4"
          >
          </div>
          <p class="text-gray-500">正在安全解密中...</p>
        </div>
      </div>

      <div id="unlock-area" class="hidden mt-4 animate-fade-in">
        <div class="bg-sky-50 p-6 rounded-2xl border border-sky-100">
          <div class="text-sky-600 mb-4">
            <svg
              class="w-12 h-12 mx-auto"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
              ></path></svg
            >
          </div>
          <h2 class="text-xl font-bold text-gray-800 mb-2">此笔记受密码保护</h2>
          <p class="text-sm text-gray-500 mb-6">请输入创建者设置的访问密码</p>
          <input
            type="password"
            id="input-pw"
            class="w-full px-5 py-3 border-2 border-sky-100 rounded-xl mb-4 focus:border-sky-400 outline-none transition-all text-center text-lg"
            placeholder="••••••••"
          />
          <button
            id="unlock-btn"
            class="w-full py-4 bg-sky-500 text-white rounded-xl font-bold hover:bg-sky-600 shadow-lg shadow-sky-200 transition-all active:scale-95"
            >解锁并查看</button
          >
        </div>
      </div>

      <div id="content-area" class="hidden text-left mt-4 animate-fade-in">
        <div
          id="burn-warning"
          class="hidden bg-amber-50 border-l-4 border-amber-500 p-4 mb-6 rounded-r-lg shadow-sm"
        >
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <svg
                class="h-5 w-5 text-amber-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm text-amber-800 font-bold">
                ⚠️ 注意：此笔记为“阅后即焚”模式
              </p>
              <p class="text-xs text-amber-700 mt-1">
                内容已从服务器删除。关闭或刷新此页面后，您将无法再次查看。请及时备份重要信息。
              </p>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between mb-4">
          <span
            class="text-xs font-bold text-gray-400 uppercase tracking-widest"
            >解密正文</span
          >
          <span id="note-date" class="text-xs text-gray-400"></span>
        </div>

        <div
          id="note-text"
          class="prose max-w-none p-6 bg-gray-50 rounded-2xl border border-gray-100 min-h-[150px] whitespace-pre-wrap break-all text-gray-800 leading-relaxed shadow-inner"
        >
        </div>

        <div id="file-list-container" class="mt-8 hidden">
          <div class="flex items-center mb-3">
            <svg
              class="w-5 h-5 text-gray-400 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828L18 9.828a4 4 0 10-5.656-5.656L6.343 9.172a6 6 0 108.485 8.485"
              ></path></svg
            >
            <h3 class="font-bold text-gray-700">安全解密的附件</h3>
          </div>
          <ul id="file-list" class="grid grid-cols-1 gap-2"></ul>
        </div>
      </div>

      <div class="mt-10 pt-6 border-t border-gray-50">
        <a
          href="/"
          class="text-sm font-semibold text-sky-500 hover:text-sky-600 transition flex items-center justify-center gap-2"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
          >
          新建我的加密笔记
        </a>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  const b642buf = (b64) => Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));

  async function init() {
    const statusArea = document.getElementById("status-area");
    const unlockArea = document.getElementById("unlock-area");
    const contentArea = document.getElementById("content-area");
    const burnWarning = document.getElementById("burn-warning");
    const noteText = document.getElementById("note-text");
    const fileList = document.getElementById("file-list");
    const fileContainer = document.getElementById("file-list-container");
    const noteDate = document.getElementById("note-date");

    const noteId = window.location.pathname.split("/").pop();
    const hashKey = window.location.hash.substring(1);

    try {
      const res = await fetch(`/api/note/${noteId}`);
      if (!res.ok) {
        const errData = await res.json();
        throw new Error(errData.error || "内容已失效或已被销毁");
      }
      const note = await res.json();

      const decryptAndShow = async (masterKeyBuf) => {
        try {
          const iv = b642buf(note.iv);
          const mKey = await window.crypto.subtle.importKey(
            "raw",
            masterKeyBuf,
            "AES-GCM",
            true,
            ["decrypt"],
          );

          // 1. 解密正文
          const decContent = await window.crypto.subtle.decrypt(
            { name: "AES-GCM", iv },
            mKey,
            b642buf(note.content),
          );
          noteText.innerText = new TextDecoder().decode(decContent);

          // 2. 解密附件
          if (note.files && note.files.length > 0) {
            fileContainer.classList.remove("hidden");
            fileList.innerHTML = "";
            for (const f of note.files) {
              const decF = await window.crypto.subtle.decrypt(
                { name: "AES-GCM", iv },
                mKey,
                b642buf(f.data),
              );
              const blob = new Blob([decF], { type: f.type });
              const url = URL.createObjectURL(blob);
              const li = document.createElement("li");
              li.innerHTML = `
                      <a href="${url}" download="${f.name}" class="flex items-center justify-between p-3 bg-white border border-gray-100 rounded-xl hover:border-sky-300 hover:shadow-md transition-all group">
                        <span class="text-gray-700 group-hover:text-sky-600 truncate mr-4">${f.name}</span>
                        <span class="text-xs bg-sky-50 text-sky-500 px-2 py-1 rounded-md font-bold shrink-0">点击保存</span>
                      </a>`;
              fileList.appendChild(li);
            }
          }

          // 3. 处理 UI 显示
          if (note.createdAt) {
            noteDate.innerText = new Date(note.createdAt).toLocaleString();
          }

          // ✨ 关键逻辑：如果是阅后即焚，显示醒目提示
          if (note.deleteAfterReading) {
            burnWarning.classList.remove("hidden");
          }

          statusArea.classList.add("hidden");
          unlockArea.classList.add("hidden");
          contentArea.classList.remove("hidden");
        } catch (e) {
          console.error("解密出错:", e);
          throw new Error("解密失败：主密钥无效或文件已损坏");
        }
      };

      if (note.hasPassword) {
        statusArea.classList.add("hidden");
        unlockArea.classList.remove("hidden");

        document.getElementById("unlock-btn").onclick = async () => {
          const pw = document.getElementById("input-pw").value;
          if (!pw) return;

          try {
            const iv = b642buf(note.iv);
            const encoder = new TextEncoder();
            const baseKey = await window.crypto.subtle.importKey(
              "raw",
              encoder.encode(pw),
              "PBKDF2",
              false,
              ["deriveKey"],
            );
            const derivedKey = await window.crypto.subtle.deriveKey(
              { name: "PBKDF2", salt: iv, iterations: 100000, hash: "SHA-256" },
              baseKey,
              { name: "AES-GCM", length: 256 },
              true,
              ["decrypt"],
            );
            const mkBuf = await window.crypto.subtle.decrypt(
              { name: "AES-GCM", iv },
              derivedKey,
              b642buf(note.key),
            );
            await decryptAndShow(mkBuf);
          } catch (e) {
            alert("密码错误，请重新输入");
          }
        };
      } else {
        if (!hashKey) throw new Error("缺少解密凭证 (URL Hash)");
        await decryptAndShow(b642buf(hashKey));
      }
    } catch (err) {
      statusArea.innerHTML = `
        <div class="bg-red-50 p-6 rounded-2xl border border-red-100 text-red-600">
            <svg class="w-12 h-12 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <p class="font-bold">加载失败</p>
            <p class="text-sm mt-1">${err.message}</p>
        </div>`;
    }
  }

  init();
</script>

<style>
  .animate-fade-in {
    animation: fadeIn 0.4s ease-out forwards;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
