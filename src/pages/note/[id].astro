---
// src/pages/note/[id].astro
import Layout from "../../layouts/Layout.astro";
const { id } = Astro.params;
---

<Layout title="查看笔记 - Transcrypt">
  <main class="flex flex-col items-center justify-center min-h-screen p-4 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800">
    <div class="glass-effect border border-white/10 p-6 sm:p-8 rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.1)] w-full max-w-3xl text-center overflow-hidden relative">
      
      <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-transparent via-blue-500/20 to-transparent"></div>

      <h1 class="text-3xl font-semibold mb-8 bg-clip-text text-transparent bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-400 tracking-tight">
        笔记内容
      </h1>

      <div id="status-area" class="space-y-4 animate-pulse">
        <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded-full w-3/4 mx-auto"></div>
        <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded-full w-1/2 mx-auto"></div>
        <p class="text-xs text-gray-400 mt-4 animate-bounce">正在建立安全通道...</p>
      </div>

      <div id="burn-confirm-area" class="hidden mt-4 animate-fade-in">
        <div class="glass-card border border-amber-200/40 p-8 rounded-3xl bg-amber-50/20">
          <div class="text-amber-500 mb-4">
            <div class="relative w-16 h-16 mx-auto">
                <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                <div class="absolute inset-0 bg-amber-500 blur-2xl opacity-20 animate-pulse"></div>
            </div>
          </div>
          <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">这是一份阅后即焚笔记</h2>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
            内容已加密。开启后，该笔记将从服务器<span class="text-red-500 font-bold underline decoration-wavy">永久消失</span>。
          </p>
          <button id="start-burn-btn" class="w-full py-4 bg-gradient-to-r from-amber-500 to-orange-600 text-white rounded-2xl font-semibold hover:shadow-[0_0_20px_rgba(245,158,11,0.4)] transition-all active:scale-95">立即解密并销毁</button>
        </div>
      </div>

      <div id="unlock-area" class="hidden mt-4 animate-fade-in">
        <div id="unlock-card" class="glass-card border border-blue-100/40 p-6 rounded-3xl bg-blue-50/20 transition-all duration-300">
          <div class="mb-6">
            <div class="w-16 h-16 bg-blue-100 dark:bg-blue-900/30 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
            </div>
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white">请输入访问密码</h2>
          </div>
          
          <div id="password-error" class="password-error-container">
            <div class="flex items-center justify-center text-red-600">
              <span class="text-sm font-bold tracking-wide">密码验证失败，请重试</span>
            </div>
          </div>
          
          <input type="password" id="input-pw" class="w-full px-5 py-4 glass-effect border border-gray-200 dark:border-white/10 rounded-2xl mb-4 focus:ring-4 focus:ring-blue-500/10 outline-none transition-all text-center text-xl tracking-[0.5em] font-mono" placeholder="••••" />
          <button id="unlock-btn" class="w-full py-4 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-2xl font-bold hover:opacity-90 transition-all active:scale-95 shadow-xl">解锁并查看</button>
        </div>
      </div>

      <div id="content-area" class="hidden text-left mt-4 animate-fade-in">
        <div id="burn-warning" class="hidden border border-amber-500/20 p-4 mb-6 rounded-2xl bg-amber-500/5 backdrop-blur-sm">
          <div class="flex items-start">
            <div class="p-2 bg-amber-500 rounded-lg text-white mr-3">
               <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.415 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
            </div>
            <div>
              <p class="text-sm text-amber-800 dark:text-amber-300 font-bold">已开启自毁模式</p>
              <p class="text-xs text-amber-700/80 dark:text-amber-400/80 mt-0.5">此内容已从云端抹除，关闭页面后将永远消失。</p>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between mb-4 px-1">
          <div class="flex items-center gap-2">
            <button id="copy-btn" class="group flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-gray-200 dark:border-gray-700/50 bg-white dark:bg-gray-800 text-gray-500 dark:text-gray-400 hover:text-blue-600 transition-all duration-300 active:scale-95 shadow-sm">
                <svg id="copy-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
                <span id="copy-text" class="text-xs font-bold uppercase tracking-wider">复制</span>
            </button>
            <button id="privacy-toggle" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-gray-200 dark:border-gray-700/50 bg-white dark:bg-gray-800 text-gray-500 hover:text-indigo-600 transition-all shadow-sm">
                <svg id="privacy-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
                <span class="text-xs font-bold uppercase">隐私模式</span>
            </button>
          </div>
          <span id="note-date" class="text-[10px] font-mono text-gray-400 uppercase"></span>
        </div>

        <div id="note-text-container" class="relative group">
            <div id="note-text" class="whitespace-pre-wrap break-all leading-relaxed font-sans text-gray-800 dark:text-gray-200 p-7 glass-effect border border-gray-100 dark:border-white/5 rounded-[2rem] min-h-[150px] shadow-inner-sm transition-all duration-500"></div>
        </div>

        <div id="file-list-container" class="mt-8 hidden">
          <div class="flex items-center mb-4 px-1">
            <div class="h-px flex-1 bg-gradient-to-r from-transparent to-gray-200 dark:to-gray-700"></div>
            <span class="px-4 text-[10px] font-black text-gray-400 uppercase tracking-[0.3em]">安全附件清单</span>
            <div class="h-px flex-1 bg-gradient-to-l from-transparent to-gray-200 dark:to-gray-700"></div>
          </div>
          <ul id="file-list" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></ul>
        </div>
      </div>

      <div class="mt-10 pt-6 border-t border-gray-100 dark:border-white/5">
        <a href="/" class="group text-sm font-bold text-gray-400 hover:text-blue-600 transition-all flex items-center justify-center gap-2">
          <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          我也要发加密笔记
        </a>
      </div>
    </div>
  </main>

  <div id="custom-alert" class="fixed inset-0 flex items-center justify-center z-[100] bg-black/60 backdrop-blur-md hidden">
    <div class="glass-card border border-red-500/20 p-8 rounded-[2rem] max-w-sm w-full mx-4 shadow-2xl relative">
      <div class="text-center">
        <div class="w-16 h-16 bg-red-50 dark:bg-red-900/40 text-red-600 rounded-2xl flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h3 id="alert-title" class="text-xl font-bold text-gray-900 dark:text-white mb-2"></h3>
        <p id="alert-message" class="text-gray-600 dark:text-gray-400 mb-8"></p>
        <button id="alert-close" class="w-full py-4 bg-red-600 text-white rounded-2xl font-bold shadow-lg shadow-red-500/30 active:scale-95 transition-all">确定</button>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  const b642buf = (b64) => Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));

  const getFileIcon = (fileName) => {
    const ext = fileName.split('.').pop().toLowerCase();
    if (['jpg','jpeg','png','gif','webp'].includes(ext)) return `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>`;
    if (['pdf'].includes(ext)) return `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>`;
    return `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828L18 9.828a4 4 0 10-5.656-5.656L6.343 9.172a6 6 0 108.485 8.485"></path></svg>`;
  }

  async function init() {
    const noteId = window.location.pathname.split("/").pop();
    const hashKey = window.location.hash.substring(1);
    const dom = {
      statusArea: document.getElementById("status-area"),
      burnConfirmArea: document.getElementById("burn-confirm-area"),
      unlockArea: document.getElementById("unlock-area"),
      unlockCard: document.getElementById("unlock-card"),
      inputPw: document.getElementById("input-pw"),
      pwError: document.getElementById("password-error"),
      contentArea: document.getElementById("content-area"),
      burnWarning: document.getElementById("burn-warning"),
      noteText: document.getElementById("note-text"),
      fileList: document.getElementById("file-list"),
      fileContainer: document.getElementById("file-list-container"),
      noteDate: document.getElementById("note-date"),
      startBurnBtn: document.getElementById("start-burn-btn"),
      unlockBtn: document.getElementById("unlock-btn"),
      copyBtn: document.getElementById("copy-btn"),
      copyIcon: document.getElementById("copy-icon"),
      copyText: document.getElementById("copy-text"),
      privacyToggle: document.getElementById("privacy-toggle"),
    };

    // 统一错误处理：摇头、重置、呼吸反馈
    const triggerPasswordError = () => {
      dom.unlockCard.classList.remove('animate-shake');
      void dom.unlockCard.offsetWidth; // 触发回流重绘
      dom.unlockCard.classList.add('animate-shake');
      dom.pwError.classList.add('show-active');
      dom.inputPw.classList.add('input-error-focus');
      dom.inputPw.value = '';
      dom.inputPw.focus();
      setTimeout(() => {
        dom.pwError.classList.remove('show-active');
        dom.inputPw.classList.remove('input-error-focus');
        dom.unlockCard.classList.remove('animate-shake');
      }, 3000);
    };

    // 隐私模式逻辑
    let isPrivate = false;
    dom.privacyToggle.onclick = () => {
      isPrivate = !isPrivate;
      dom.noteText.classList.toggle('privacy-blur', isPrivate);
      dom.privacyToggle.classList.toggle('text-indigo-600', isPrivate);
    };

    const handleCopy = async () => {
      try {
        await navigator.clipboard.writeText(dom.noteText.innerText);
        const oldHtml = dom.copyIcon.innerHTML;
        const oldText = dom.copyText.innerText;
        dom.copyIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>`;
        dom.copyText.innerText = "成功";
        dom.copyBtn.classList.add("copy-success");
        setTimeout(() => {
          dom.copyIcon.innerHTML = oldHtml;
          dom.copyText.innerText = oldText;
          dom.copyBtn.classList.remove("copy-success");
        }, 2000);
      } catch (e) {}
    };
    dom.copyBtn.onclick = handleCopy;

    try {
      const res = await fetch(`/api/note/${noteId}`);
      if (!res.ok) throw new Error("内容已失效或已被销毁");
      const note = await res.json();

      const decryptAndShow = async (masterKeyBuf) => {
        try {
          const iv = b642buf(note.iv);
          const mKey = await window.crypto.subtle.importKey("raw", masterKeyBuf, "AES-GCM", true, ["decrypt"]);
          const decContent = await window.crypto.subtle.decrypt({ name: "AES-GCM", iv }, mKey, b642buf(note.content));
          
          dom.noteText.innerText = new TextDecoder().decode(decContent);

          if (note.files?.length > 0) {
            dom.fileContainer.classList.remove("hidden");
            dom.fileList.innerHTML = "";
            for (const f of note.files) {
              const decF = await window.crypto.subtle.decrypt({ name: "AES-GCM", iv }, mKey, b642buf(f.data));
              const url = URL.createObjectURL(new Blob([decF], { type: f.type }));
              const li = document.createElement("li");
              li.className = "group";
              li.innerHTML = `
                <a href="${url}" download="${f.name}" class="flex items-center p-4 bg-white dark:bg-white/5 border border-gray-100 dark:border-white/10 rounded-2xl hover:border-blue-500 transition-all shadow-sm">
                  <div class="p-2 bg-blue-50 dark:bg-blue-500/10 text-blue-600 rounded-lg mr-3 group-hover:scale-110 transition-transform">
                    ${getFileIcon(f.name)}
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-gray-700 dark:text-gray-200 truncate">${f.name}</p>
                    <p class="text-[10px] text-gray-400 uppercase font-bold tracking-tighter">点击下载安全附件</p>
                  </div>
                </a>`;
              dom.fileList.appendChild(li);
            }
          }

          if (note.createdAt) dom.noteDate.innerText = new Date(note.createdAt).toLocaleString();
          if (note.deleteAfterReading) {
            fetch(`/api/note/${noteId}`, { method: 'DELETE' }).catch(console.error);
            dom.burnWarning.classList.remove("hidden");
          }

          dom.statusArea.classList.add("hidden");
          dom.burnConfirmArea.classList.add("hidden");
          dom.unlockArea.classList.add("hidden");
          dom.contentArea.classList.remove("hidden");
        } catch (e) {
          triggerPasswordError();
        }
      };

      if (note.deleteAfterReading) {
        dom.statusArea.classList.add("hidden");
        dom.burnConfirmArea.classList.remove("hidden");
        dom.startBurnBtn.onclick = async () => {
          if (note.hasPassword) {
            dom.burnConfirmArea.classList.add("hidden");
            dom.unlockArea.classList.remove("hidden");
          } else {
            await decryptAndShow(b642buf(hashKey));
          }
        };
      } else if (note.hasPassword) {
        dom.statusArea.classList.add("hidden");
        dom.unlockArea.classList.remove("hidden");
      } else {
        await decryptAndShow(b642buf(hashKey));
      }

      dom.unlockBtn.onclick = async () => {
        const pw = dom.inputPw.value;
        if (!pw) { triggerPasswordError(); return; }
        try {
          const iv = b642buf(note.iv);
          const encoder = new TextEncoder();
          const baseKey = await window.crypto.subtle.importKey("raw", encoder.encode(pw), "PBKDF2", false, ["deriveKey"]);
          const derivedKey = await window.crypto.subtle.deriveKey({ name: "PBKDF2", salt: iv, iterations: 100000, hash: "SHA-256" }, baseKey, { name: "AES-GCM", length: 256 }, true, ["decrypt"]);
          const mkBuf = await window.crypto.subtle.decrypt({ name: "AES-GCM", iv }, derivedKey, b642buf(note.key));
          await decryptAndShow(mkBuf);
        } catch (e) {
          triggerPasswordError();
        }
      };

    } catch (err) {
      dom.statusArea.innerHTML = `<div class="p-6 rounded-2xl bg-red-50 dark:bg-red-900/20 text-red-600 text-sm font-bold border border-red-200 dark:border-red-900/50">${err.message}</div>`;
    }
  }
  init();
</script>

<style>
  .glass-effect { backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); background-color: rgba(255, 255, 255, 0.9); }
  .dark .glass-effect { background-color: rgba(15, 23, 42, 0.8); }
  
  .glass-card { backdrop-filter: blur(12px); background-color: rgba(255, 255, 255, 0.5); }
  .dark .glass-card { background-color: rgba(30, 41, 59, 0.5); }

  /* 物理摇头动画 */
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-6px); }
    20%, 40%, 60%, 80% { transform: translateX(6px); }
  }
  .animate-shake { animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both; }

  /* 错误状态呼吸效果 */
  .input-error-focus {
    border-color: rgba(239, 68, 68, 0.5) !important;
    box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.1) !important;
    background-color: rgba(239, 68, 68, 0.02) !important;
  }

  .privacy-blur { filter: blur(12px); opacity: 0.3; user-select: none; pointer-events: none; }
  .password-error-container { max-height: 0; opacity: 0; transition: all 0.3s ease; overflow: hidden; }
  .password-error-container.show-active { max-height: 40px; opacity: 1; margin-bottom: 1rem; }

  .copy-success { background-color: #f0fdf4 !important; border-color: #bbf7d0 !important; color: #16a34a !important; }
  .dark .copy-success { background-color: rgba(22, 163, 74, 0.1) !important; }

  .animate-fade-in { animation: fadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .shadow-inner-sm { box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.03); }
</style>