---
// src/pages/note/[id].astro
import Layout from "../../layouts/Layout.astro";
const { id } = Astro.params;
---

<Layout title="查看笔记 - Transcrypt">
  <main class="flex flex-col items-center justify-center min-h-screen p-4 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800">
    <div class="glass-effect border border-white/10 p-6 sm:p-8 rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.1)] w-full max-w-3xl text-center overflow-hidden relative">
      
      <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-blue-500/40 to-transparent animate-pulse"></div>

      <h1 class="text-3xl font-bold mb-8 bg-clip-text text-transparent bg-gradient-to-r from-gray-900 to-gray-400 dark:from-white dark:to-gray-500 tracking-tighter">
        Note Decryptor
      </h1>

      <div id="status-area">
        <div class="flex flex-col items-center py-12">
            <div class="relative w-12 h-12 mb-6">
                <div class="absolute inset-0 border-4 border-blue-500/10 rounded-full"></div>
                <div class="absolute inset-0 border-4 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
            </div>
            <p class="text-[10px] text-gray-400 font-black uppercase tracking-[0.3em] animate-pulse">Establishing Secure Link</p>
        </div>
      </div>

      <div id="burn-confirm-area" class="hidden mt-4 animate-fade-in">
        <div class="glass-card border border-amber-200/40 p-8 rounded-[2.5rem] bg-amber-50/10">
          <div class="text-amber-500 mb-6 relative">
             <svg class="w-16 h-16 mx-auto relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
             </svg>
             <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-24 h-24 bg-amber-500/20 blur-3xl rounded-full"></div>
          </div>
          <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">阅后即焚内容</h2>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-8 leading-relaxed">
            该笔记被设定为读取后自动销毁。<br/>开启后，数据将从云端<span class="text-red-500 font-black">永久离线</span>。
          </p>
          <button id="start-burn-btn" class="w-full py-4 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-2xl font-bold hover:shadow-2xl transition-all active:scale-95">解密并销毁</button>
        </div>
      </div>

      <div id="unlock-area" class="hidden mt-4 animate-fade-in">
        <div id="unlock-card" class="glass-card border border-blue-100/30 p-8 rounded-[2.5rem] bg-blue-50/10 transition-all duration-500">
          <div class="mb-8">
            <div class="w-14 h-14 bg-blue-600/10 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-blue-500/20">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
            </div>
            <h2 class="text-lg font-bold text-gray-900 dark:text-white">身份验证</h2>
            <p class="text-xs text-gray-400 mt-1 uppercase tracking-widest font-black">Password Protected</p>
          </div>
          
          <div id="password-error" class="password-error-container">
            <p class="text-red-500 text-xs font-black mb-4">ACCESS DENIED: INCORRECT PASSWORD</p>
          </div>
          
          <input type="password" id="input-pw" class="w-full px-5 py-5 bg-white dark:bg-gray-800 border-2 border-transparent focus:border-blue-500/50 rounded-2xl mb-4 outline-none transition-all text-center text-2xl tracking-[0.5em] font-mono shadow-inner" placeholder="••••" />
          <button id="unlock-btn" class="w-full py-4 bg-blue-600 text-white rounded-2xl font-bold shadow-lg shadow-blue-500/20 hover:bg-blue-700 transition-all active:scale-95">验证凭据</button>
        </div>
      </div>

      <div id="content-area" class="hidden text-left mt-4 animate-fade-in">
        <div id="burn-warning" class="hidden border border-amber-500/20 p-4 mb-6 rounded-2xl bg-amber-500/5 backdrop-blur-md overflow-hidden relative">
          <div class="flex items-center relative z-10">
            <div class="w-2 h-2 bg-amber-500 rounded-full animate-ping mr-3"></div>
            <p class="text-[10px] text-amber-800 dark:text-amber-300 font-black uppercase tracking-widest">Security Status: Self-Destruct Initiated</p>
          </div>
          <div class="absolute top-0 right-0 p-4 opacity-10">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 20 20"><path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1a1 1 0 112 0v1a1 1 0 11-2 0zm6.657-1.414a1 1 0 111.414 1.414l-.707.707a1 1 0 11-1.414-1.414l.707-.707zM6.343 14.586a1 1 0 01-1.414 1.414l-.707-.707a1 1 0 011.414-1.414l.707.707z"/></svg>
          </div>
        </div>

        <div class="flex items-center justify-between mb-4 px-1">
          <div class="flex items-center gap-3">
            <button id="copy-btn" class="flex items-center gap-1.5 px-4 py-2 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-500 hover:text-blue-600 transition-all active:scale-95">
                <svg id="copy-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
                <span id="copy-text" class="text-xs font-bold uppercase tracking-tighter">Copy</span>
            </button>
            <button id="privacy-toggle" class="flex items-center gap-1.5 px-4 py-2 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-500 hover:text-indigo-600 transition-all active:scale-95">
                <svg id="privacy-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.477 0-8.268-2.943-9.542-7a9.956 9.956 0 012.233-3.291m2.158-1.965a3 3 0 114.243 4.243" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3l18 18" />
                </svg>
                <span class="text-xs font-bold uppercase tracking-tighter">Hide</span>
            </button>
          </div>
          <div class="flex flex-col items-end">
            <span id="note-date" class="text-[10px] font-black text-gray-300 dark:text-gray-600 tracking-tighter uppercase"></span>
          </div>
        </div>

        <div id="note-text-container" class="relative group">
            <div class="security-mesh absolute inset-0 opacity-[0.03] pointer-events-none"></div>
            <div id="note-text" class="note-paper relative whitespace-pre-wrap break-all leading-[1.8] font-sans text-gray-800 dark:text-gray-200 p-8 sm:p-10 glass-effect border border-gray-100 dark:border-white/5 rounded-[2.5rem] min-h-[200px] shadow-inner-sm transition-all duration-700"></div>
        </div>

        <div id="file-list-container" class="mt-8 hidden">
          <div class="flex items-center mb-5 px-1">
            <span class="text-[10px] font-black text-gray-400 uppercase tracking-[0.4em]">Decrypted Assets</span>
            <div class="h-px flex-1 bg-gradient-to-r from-gray-200 dark:from-gray-700 to-transparent ml-4"></div>
          </div>
          <ul id="file-list" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></ul>
        </div>
      </div>

      <div class="mt-12 pt-8 border-t border-gray-100 dark:border-white/5">
        <a href="/" class="group inline-flex items-center gap-3 px-6 py-2 rounded-full text-xs font-bold text-gray-400 hover:text-blue-600 transition-all">
          <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Create New Secure Note
        </a>
      </div>
    </div>
  </main>

  <div id="custom-alert" class="fixed inset-0 flex items-center justify-center z-[100] bg-black/80 backdrop-blur-xl hidden">
    <div class="glass-card border border-red-500/20 p-10 rounded-[3rem] max-w-sm w-full mx-4 shadow-2xl scale-95 animate-fade-in text-center">
        <div class="w-20 h-20 bg-red-500/10 text-red-500 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        <h3 id="alert-title" class="text-xl font-bold text-white mb-2 tracking-tight"></h3>
        <p id="alert-message" class="text-gray-400 text-sm mb-10 leading-relaxed"></p>
        <button id="alert-close" class="w-full py-4 bg-white text-black rounded-2xl font-black uppercase tracking-widest text-xs hover:bg-gray-100 transition-all">Dismiss</button>
    </div>
  </div>
</Layout>

<script is:inline>
  const b642buf = (b64) => Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));

  const getFileIcon = (fileName) => {
    const ext = fileName.split('.').pop().toLowerCase();
    if (['jpg','jpeg','png','gif','webp'].includes(ext)) return `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>`;
    return `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828L18 9.828a4 4 0 10-5.656-5.656L6.343 9.172a6 6 0 108.485 8.485"></path></svg>`;
  }

  async function init() {
    const noteId = window.location.pathname.split("/").pop();
    const hashKey = window.location.hash.substring(1);
    const dom = {
      statusArea: document.getElementById("status-area"),
      burnConfirmArea: document.getElementById("burn-confirm-area"),
      unlockArea: document.getElementById("unlock-area"),
      unlockCard: document.getElementById("unlock-card"),
      inputPw: document.getElementById("input-pw"),
      pwError: document.getElementById("password-error"),
      contentArea: document.getElementById("content-area"),
      burnWarning: document.getElementById("burn-warning"),
      noteText: document.getElementById("note-text"),
      fileList: document.getElementById("file-list"),
      fileContainer: document.getElementById("file-list-container"),
      noteDate: document.getElementById("note-date"),
      startBurnBtn: document.getElementById("start-burn-btn"),
      unlockBtn: document.getElementById("unlock-btn"),
      copyBtn: document.getElementById("copy-btn"),
      copyIcon: document.getElementById("copy-icon"),
      copyText: document.getElementById("copy-text"),
      privacyToggle: document.getElementById("privacy-toggle"),
    };

    const triggerPasswordError = () => {
      dom.unlockCard.classList.remove('animate-shake');
      void dom.unlockCard.offsetWidth; 
      dom.unlockCard.classList.add('animate-shake');
      dom.pwError.classList.add('show-active');
      dom.inputPw.classList.add('input-error-focus');
      dom.inputPw.value = '';
      dom.inputPw.focus();
      setTimeout(() => {
        dom.pwError.classList.remove('show-active');
        dom.inputPw.classList.remove('input-error-focus');
      }, 3000);
    };

    let isPrivate = false;
    dom.privacyToggle.onclick = () => {
      isPrivate = !isPrivate;
      dom.noteText.classList.toggle('privacy-blur', isPrivate);
      dom.privacyToggle.classList.toggle('bg-indigo-500', isPrivate);
      dom.privacyToggle.classList.toggle('text-white', isPrivate);
    };

    dom.copyBtn.onclick = async () => {
      await navigator.clipboard.writeText(dom.noteText.innerText);
      const oldHtml = dom.copyIcon.innerHTML;
      dom.copyIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>`;
      dom.copyBtn.classList.add("bg-emerald-500", "text-white");
      setTimeout(() => {
        dom.copyIcon.innerHTML = oldHtml;
        dom.copyBtn.classList.remove("bg-emerald-500", "text-white");
      }, 2000);
    };

    try {
      const res = await fetch(`/api/note/${noteId}`);
      if (!res.ok) throw new Error("内容已失效或已被销毁");
      const note = await res.json();

      const decryptAndShow = async (masterKeyBuf) => {
        try {
          const iv = b642buf(note.iv);
          const mKey = await window.crypto.subtle.importKey("raw", masterKeyBuf, "AES-GCM", true, ["decrypt"]);
          const decContent = await window.crypto.subtle.decrypt({ name: "AES-GCM", iv }, mKey, b642buf(note.content));
          
          dom.noteText.innerText = new TextDecoder().decode(decContent);

          if (note.files?.length > 0) {
            dom.fileContainer.classList.remove("hidden");
            for (const f of note.files) {
              const decF = await window.crypto.subtle.decrypt({ name: "AES-GCM", iv }, mKey, b642buf(f.data));
              const url = URL.createObjectURL(new Blob([decF], { type: f.type }));
              const li = document.createElement("li");
              li.innerHTML = `
                <a href="${url}" download="${f.name}" class="flex items-center p-4 bg-white dark:bg-white/5 border border-gray-100 dark:border-white/10 rounded-2xl hover:border-blue-500 transition-all shadow-sm hover:shadow-xl group">
                  <div class="p-3 bg-blue-50 dark:bg-blue-500/10 text-blue-600 rounded-xl mr-4 group-hover:scale-110 transition-transform">${getFileIcon(f.name)}</div>
                  <div class="flex-1 min-w-0">
                    <p class="text-xs font-bold text-gray-700 dark:text-gray-200 truncate">${f.name}</p>
                    <p class="text-[9px] text-gray-400 uppercase tracking-widest mt-1 font-black">Encrypted Binary</p>
                  </div>
                </a>`;
              dom.fileList.appendChild(li);
            }
          }

          if (note.createdAt) dom.noteDate.innerText = `Timestamp: ${new Date(note.createdAt).getTime()}`;
          if (note.deleteAfterReading) {
            fetch(`/api/note/${noteId}`, { method: 'DELETE' }).catch(console.error);
            dom.burnWarning.classList.remove("hidden");
          }

          dom.statusArea.classList.add("hidden");
          dom.burnConfirmArea.classList.add("hidden");
          dom.unlockArea.classList.add("hidden");
          dom.contentArea.classList.remove("hidden");
        } catch (e) {
          triggerPasswordError();
        }
      };

      if (note.deleteAfterReading) {
        dom.statusArea.classList.add("hidden");
        dom.burnConfirmArea.classList.remove("hidden");
        dom.startBurnBtn.onclick = async () => {
          if (note.hasPassword) {
            dom.burnConfirmArea.classList.add("hidden");
            dom.unlockArea.classList.remove("hidden");
          } else {
            await decryptAndShow(b642buf(hashKey));
          }
        };
      } else if (note.hasPassword) {
        dom.statusArea.classList.add("hidden");
        dom.unlockArea.classList.remove("hidden");
      } else {
        await decryptAndShow(b642buf(hashKey));
      }

      dom.unlockBtn.onclick = async () => {
        const pw = dom.inputPw.value;
        if (!pw) { triggerPasswordError(); return; }
        try {
          const iv = b642buf(note.iv);
          const encoder = new TextEncoder();
          const baseKey = await window.crypto.subtle.importKey("raw", encoder.encode(pw), "PBKDF2", false, ["deriveKey"]);
          const derivedKey = await window.crypto.subtle.deriveKey({ name: "PBKDF2", salt: iv, iterations: 100000, hash: "SHA-256" }, baseKey, { name: "AES-GCM", length: 256 }, true, ["decrypt"]);
          const mkBuf = await window.crypto.subtle.decrypt({ name: "AES-GCM", iv }, derivedKey, b642buf(note.key));
          await decryptAndShow(mkBuf);
        } catch (e) {
          triggerPasswordError();
        }
      };

    } catch (err) {
      dom.statusArea.innerHTML = `
        <div class="animate-fade-in py-12 flex flex-col items-center">
          <div class="w-20 h-20 mb-8 relative">
            <div class="absolute inset-0 bg-red-500/20 rounded-full animate-pulse"></div>
            <div class="relative bg-white dark:bg-gray-800 border-2 border-red-500 rounded-full w-20 h-20 flex items-center justify-center">
              <svg class="w-10 h-10 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
            </div>
          </div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">ACCESS TERMINATED</h3>
          <p class="text-xs text-gray-400 max-w-xs leading-relaxed tracking-tight">The requested data fragment has been successfully purged from our servers or has exceeded its lifespan.</p>
          <div class="mt-8 px-4 py-1 rounded-full bg-red-500/10 text-red-500 text-[9px] font-black uppercase tracking-widest">Status: Purged</div>
        </div>
      `;
    }
  }
  init();
</script>

<style>
  .glass-effect { backdrop-filter: blur(40px); background-color: rgba(255, 255, 255, 0.94); }
  .dark .glass-effect { background-color: rgba(15, 23, 42, 0.9); }
  
  .glass-card { backdrop-filter: blur(20px); background-color: rgba(255, 255, 255, 0.4); }
  .dark .glass-card { background-color: rgba(30, 41, 59, 0.4); }

  .security-mesh {
    background-image: radial-gradient(#3b82f6 0.5px, transparent 0.5px);
    background-size: 24px 24px;
  }

  .note-paper {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    letter-spacing: -0.01em;
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    15% { transform: translateX(-8px); }
    30% { transform: translateX(8px); }
    45% { transform: translateX(-6px); }
    60% { transform: translateX(6px); }
    75% { transform: translateX(-4px); }
  }
  .animate-shake { animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both; }

  .privacy-blur {
    filter: blur(24px) saturate(2) contrast(0.8);
    opacity: 0.2;
    transform: scale(0.99);
    pointer-events: none;
    transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .input-error-focus {
    border-color: rgba(239, 68, 68, 0.4) !important;
    background-color: rgba(239, 68, 68, 0.01) !important;
  }

  .password-error-container { max-height: 0; opacity: 0; transition: 0.4s ease; overflow: hidden; }
  .password-error-container.show-active { max-height: 40px; opacity: 1; }

  .animate-fade-in { animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

  .shadow-inner-sm { box-shadow: inset 0 2px 8px 0 rgba(0, 0, 0, 0.04); }
</style>