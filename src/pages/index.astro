---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header";
import Footer from "../components/Footer";
import NoteEditor from "../components/NoteEditor.astro";
---

<Layout title="安全分享 - Transcrypt">
  <Header client:load />
  <NoteEditor />
  <Footer client:load />
</Layout>

<script is:inline>
  /**
   * Transcrypt 核心前端加密脚本
   * 采用 Web Crypto API (AES-GCM + PBKDF2)
   */
  if (typeof window !== "undefined") {
    let selectedExpiration = "1hour";
    let uploadedFiles = [];
    const MAX_SIZE_MB = 10;
    const MAX_FILE_SIZE = MAX_SIZE_MB * 1024 * 1024;

    const EXP_BTN_DEFAULT_CLASS =
      "py-2.5 px-4 rounded-xl text-sm font-medium transition-all bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-500/10 hover:text-blue-600";
    const EXP_BTN_ACTIVE_CLASS =
      "py-2.5 px-4 rounded-xl text-sm font-medium transition-all bg-blue-500/90 text-white shadow-sm";

    const strengthLabels = ["非常弱", "弱", "中等", "强", "非常强"];
    const strengthColors = [
      "bg-red-500",
      "bg-orange-400",
      "bg-yellow-400",
      "bg-green-400",
      "bg-green-600",
    ];

    // --- DOM 引用 ---
    const dom = {
      noteContent: document.getElementById("note-content"),
      notePassword: document.getElementById("note-password"),
      createBtn: document.getElementById("create-note-button"),

      neverExpires: document.getElementById("never-expires"),
      burnAfterRead: document.getElementById("delete-after-reading"),
      expOptions: document.getElementById("expiration-options"),

      togglePwBtn: document.getElementById("toggle-password"),
      eyeOpen: document.getElementById("eye-open"),
      eyeClosed: document.getElementById("eye-closed"),
      genPwBtn: document.getElementById("generate-password"),
      pwStrengthText: document.getElementById("password-strength-text"),
      pwStrengthFill: document.getElementById("password-strength-fill"),

      uploadBtn: document.getElementById("upload-btn"),
      fileInput: document.getElementById("file-input"),
      uploadArea: document.getElementById("upload-area"),
      fileList: document.getElementById("file-list"),
      errorMsg: document.getElementById("error-message"),
      errorText: document.getElementById("error-text"),

      successModal: document.getElementById("success-modal"),
      successContent: document.getElementById("success-modal-content"),
      linkDisplay: document.getElementById("encrypted-link-display"),
      copyBtn: document.getElementById("copy-link-button"),
      copyIcon: document.getElementById("copy-icon"),
      checkIcon: document.getElementById("check-icon"),
      copyFeedback: document.getElementById("copy-feedback"),
      qrcodeCanvas: document.getElementById("qrcode-canvas"),
      closeModalBtn: document.getElementById("close-modal-button"),
      shareEmailBtn: document.getElementById("share-email-button"),

      errorPopup: document.getElementById("error-popup"),
      errorPopupContent: document.getElementById("error-popup-content"),
      errorPopupOverlay: document.getElementById("error-popup-overlay"),
      errorPopupCloseBtn: document.getElementById("error-popup-close-btn"),
      errorPopupMessage: document.getElementById("error-popup-message"),

      maxAccess: document.getElementById("max-access"),
      antiBruteForce: document.getElementById("anti-brute-force"),
    };

    const buf2b64 = (buf) => btoa(String.fromCharCode(...new Uint8Array(buf)));
    const formatBytes = (bytes) => {
      if (bytes === 0) return "0 Bytes";
      const i = Math.floor(Math.log(bytes) / Math.log(1024));
      return (
        parseFloat((bytes / Math.pow(1024, i)).toFixed(2)) +
        " " +
        ["Bytes", "KB", "MB", "GB"][i]
      );
    };

    const showErrorPopup = (message = "操作失败，请稍后重试") => {
      if (!dom.errorPopup) return alert(message);

      dom.errorPopupMessage.textContent = message;
      dom.errorPopup.classList.remove("hidden");

      setTimeout(() => {
        dom.errorPopupContent.classList.remove("scale-90", "opacity-0");
        dom.errorPopupContent.classList.add("scale-100", "opacity-100");
      }, 10);
    };

    async function handleCreateNote() {
      const content = dom.noteContent.value.trim();
      const password = dom.notePassword.value;
      const maxAccessVal = dom.maxAccess?.value
        ? parseInt(dom.maxAccess.value)
        : null;
      const antiBruteForceEnabled = dom.antiBruteForce?.checked || false;

      if (!content && uploadedFiles.length === 0)
        return showErrorPopup("内容或附件不能为空");

      dom.createBtn.disabled = true;
      dom.createBtn.innerText = "加密中...";

      try {
        const masterKey = await window.crypto.subtle.generateKey(
          { name: "AES-GCM", length: 256 },
          true,
          ["encrypt", "decrypt"],
        );
        const rawMasterKey = await window.crypto.subtle.exportKey(
          "raw",
          masterKey,
        );

        const iv = window.crypto.getRandomValues(new Uint8Array(12));
        const encoder = new TextEncoder();

        const encContent = await window.crypto.subtle.encrypt(
          { name: "AES-GCM", iv },
          masterKey,
          encoder.encode(content),
        );

        const encFiles = await Promise.all(
          uploadedFiles.map(async (file) => {
            const buf = await file.arrayBuffer();
            const encF = await window.crypto.subtle.encrypt(
              { name: "AES-GCM", iv },
              masterKey,
              buf,
            );
            return {
              name: file.name,
              type: file.type,
              size: file.size,
              data: buf2b64(encF),
            };
          }),
        );

        let storedKey;
        const masterKeyB64 = buf2b64(rawMasterKey);

        if (password) {
          const pwBuf = encoder.encode(password);
          const baseKey = await window.crypto.subtle.importKey(
            "raw",
            pwBuf,
            "PBKDF2",
            false,
            ["deriveKey"],
          );
          // 防爆破模式：使用更高的迭代次数 (60万次)
          const iterations = antiBruteForceEnabled ? 600000 : 100000;
          const derivedKey = await window.crypto.subtle.deriveKey(
            {
              name: "PBKDF2",
              salt: iv,
              iterations: iterations,
              hash: "SHA-256",
            },
            baseKey,
            { name: "AES-GCM", length: 256 },
            true,
            ["encrypt"],
          );
          const encMasterKey = await window.crypto.subtle.encrypt(
            { name: "AES-GCM", iv },
            derivedKey,
            rawMasterKey,
          );
          storedKey = buf2b64(encMasterKey);
        } else {
          storedKey = masterKeyB64;
        }

        const noteId = crypto.randomUUID();
        const payload = {
          id: noteId,
          content: buf2b64(encContent),
          key: storedKey,
          iv: buf2b64(iv),
          hasPassword: !!password,
          antiBruteForce: antiBruteForceEnabled,
          maxAccess: maxAccessVal,
          files: encFiles,
          expiration: dom.neverExpires.checked ? null : getTTLSeconds(),
          deleteAfterReading: dom.burnAfterRead.checked,
          createdAt: new Date().toISOString(),
        };

        const response = await fetch("/api/note", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        if (!response.ok) throw new Error("服务器保存失败");
        const finalLink = `${window.location.origin}/note/${noteId}#${masterKeyB64}`;
        showSuccess(finalLink);
      } catch (err) {
        console.error("创建笔记失败:", err);
        showErrorPopup("创建笔记失败: " + err.message);
      } finally {
        dom.createBtn.disabled = false;
        dom.createBtn.innerText = "创建笔记";
      }
    }

    function getTTLSeconds() {
      const map = {
        "1hour": 3600,
        "1day": 86400,
        "1week": 604800,
        "1month": 2592000,
      };
      return map[selectedExpiration] || 3600;
    }

    function showSuccess(link) {
      dom.linkDisplay.value = link;
      dom.successModal.classList.remove("hidden");

      setTimeout(() => {
        dom.successContent.classList.remove("scale-95", "opacity-0");
        dom.successContent.classList.add("scale-100", "opacity-100");
      }, 10);

      if (window.QRCodeGenerator) {
        window.QRCodeGenerator.toCanvas(dom.qrcodeCanvas, link, { width: 128 });
      }
    }

    dom.fileInput.onchange = () => {
      const files = Array.from(dom.fileInput.files);
      uploadedFiles = [...uploadedFiles, ...files].filter((f) => {
        if (f.size > MAX_FILE_SIZE) {
          showErrorPopup(`文件 ${f.name} 超过 10MB 限制`);
          return false;
        }
        return true;
      });

      renderFileList();
    };

    function renderFileList() {
      dom.fileList.innerHTML = "";

      if (uploadedFiles.length === 0) {
        dom.uploadArea.classList.add("hidden");
        return;
      }

      uploadedFiles.forEach((f, index) => {
        const fileItem = document.createElement("div");
        fileItem.className =
          "flex items-center justify-between py-2 px-3 rounded-lg bg-gray-50 dark:bg-gray-800/50 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors";
        fileItem.innerHTML = `
          <div class="flex items-center gap-2 overflow-hidden">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500 dark:text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span class="truncate text-sm text-gray-800 dark:text-gray-200 font-medium">${f.name}</span>
          </div>
          <div class="flex items-center gap-3 flex-shrink-0">
            <span class="text-xs text-gray-500 dark:text-gray-400 min-w-[60px] text-right">${formatBytes(f.size)}</span>
            <button 
              class="file-remove-btn text-gray-400 hover:text-red-500 transition-colors" 
              title="移除文件"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        `;

        const removeBtn = fileItem.querySelector(".file-remove-btn");
        removeBtn.addEventListener("click", () => {
          uploadedFiles.splice(index, 1);
          renderFileList();
        });

        dom.fileList.appendChild(fileItem);
      });

      dom.uploadArea.classList.remove("hidden");
    }

    dom.notePassword.oninput = () => {
      const val = dom.notePassword.value;
      if (window.zxcvbn && val) {
        const result = zxcvbn(val);
        dom.pwStrengthText.textContent = `强度: ${strengthLabels[result.score]}`;
        dom.pwStrengthFill.className = `h-full transition-all duration-300 ${strengthColors[result.score]}`;
        dom.pwStrengthFill.style.width = `${(result.score + 1) * 20}%`;
      } else {
        dom.pwStrengthText.textContent = "";
        dom.pwStrengthFill.style.width = "0%";
      }
    };

    dom.togglePwBtn.onclick = () => {
      const isVisible = dom.notePassword.type === "text";
      dom.notePassword.type = isVisible ? "password" : "text";
      dom.eyeOpen.classList.toggle("hidden", isVisible);
      dom.eyeClosed.classList.toggle("hidden", !isVisible);
    };

    dom.copyBtn.onclick = () => {
      dom.linkDisplay.select();
      navigator.clipboard
        .writeText(dom.linkDisplay.value)
        .then(() => {
          dom.copyIcon.classList.add("hidden");
          dom.checkIcon.classList.remove("hidden");
          dom.copyFeedback.classList.replace("opacity-0", "opacity-100");

          setTimeout(() => {
            dom.copyIcon.classList.remove("hidden");
            dom.checkIcon.classList.add("hidden");
            dom.copyFeedback.classList.replace("opacity-100", "opacity-0");
          }, 2000);
        })
        .catch(() => {
          showErrorPopup("复制失败，请手动复制链接");
        });
    };

    function updateExpirationOptionsUI() {
      const isNever = dom.neverExpires.checked;
      const buttons = dom.expOptions.querySelectorAll("button");

      dom.expOptions.classList.add("cursor-not-allowed");

      buttons.forEach((btn) => {
        if (isNever) {
          btn.classList.add("opacity-40", "pointer-events-none");
          btn.classList.remove("cursor-not-allowed");
        } else {
          dom.expOptions.classList.remove("cursor-not-allowed");
          buttons.forEach((btn) => {
            btn.classList.remove("opacity-40", "pointer-events-none");
          });
        }
      });
    }

    dom.expOptions.onclick = (e) => {
      if (dom.neverExpires.checked) return;

      const btn = e.target.closest("button");
      if (!btn) return;

      dom.expOptions.querySelectorAll("button").forEach((b) => {
        b.className = EXP_BTN_DEFAULT_CLASS;
      });

      btn.className = EXP_BTN_ACTIVE_CLASS;
      selectedExpiration = btn.dataset.value;
    };

    dom.neverExpires.onchange = () => {
      if (dom.neverExpires.checked) {
        dom.burnAfterRead.checked = false;
        updateExpirationOptionsUI();

        dom.maxAccess.disabled = false;
        dom.maxAccess.parentElement.classList.remove("opacity-50");
      } else {
        updateExpirationOptionsUI();
      }
    };

    dom.burnAfterRead.onchange = () => {
      if (dom.burnAfterRead.checked) {
        dom.neverExpires.checked = false;
        dom.maxAccess.value = "1";
        dom.maxAccess.disabled = true;
        dom.maxAccess.parentElement.classList.add(
          "opacity-50",
          "transition-opacity",
        );
      } else {
        dom.maxAccess.disabled = false;
        dom.maxAccess.parentElement.classList.remove("opacity-50");
      }
      updateExpirationOptionsUI();
    };

    dom.shareEmailBtn.onclick = () => {
      const email = prompt("请输入收件人邮箱:");
      if (email) {
        window.location.href = `mailto:${email}?subject=加密笔记分享&body=请查看此加密笔记: ${dom.linkDisplay.value}`;
      }
    };

    dom.genPwBtn.onclick = () => {
      const charset =
        "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*";
      let retVal = "";
      for (let i = 0; i < 16; ++i) {
        retVal += charset.charAt(Math.floor(Math.random() * charset.length));
      }
      dom.notePassword.value = retVal;
      dom.notePassword.dispatchEvent(new Event("input"));
    };

    dom.closeModalBtn.onclick = () => window.location.reload();

    if (dom.errorPopupCloseBtn) {
      dom.errorPopupCloseBtn.onclick = () => {
        dom.errorPopup.classList.add("hidden");
        dom.errorPopupContent.classList.remove("scale-100", "opacity-100");
        dom.errorPopupContent.classList.add("scale-90", "opacity-0");
      };

      dom.errorPopupOverlay.onclick = () => {
        dom.errorPopup.classList.add("hidden");
        dom.errorPopupContent.classList.remove("scale-100", "opacity-100");
        dom.errorPopupContent.classList.add("scale-90", "opacity-0");
      };
    }

    dom.createBtn.onclick = handleCreateNote;

    // 上传按钮点击事件
    dom.uploadBtn.onclick = () => {
      if (dom.fileInput) {
        dom.fileInput.click();
      } else {
        showErrorPopup("文件上传控件未找到");
      }
    };

    if (dom.expOptions) {
      const defaultBtn = dom.expOptions.querySelector('[data-value="1hour"]');
      if (defaultBtn) {
        defaultBtn.className = EXP_BTN_ACTIVE_CLASS;
      }
    }
  }
</script>
